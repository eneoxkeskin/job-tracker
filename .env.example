# Copy to .env and fill in real values. Never commit .env.

# Use sslmode=verify-full in both URLs (pg v9 will weaken "require" to libpq semantics).

# Neon pooled connection (host contains "-pooler") — used by the app at runtime
DATABASE_URL=""

# Neon direct connection — used only by the Prisma CLI (migrations)
DIRECT_URL=""

# Auth.js — generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=""

# GitHub OAuth App (callback: http://localhost:3000/api/auth/callback/github)
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""

# Protects the daily demo cleanup cron (/api/cron/cleanup-demo). Vercel sends it as
# "Authorization: Bearer <value>". At least 16 characters; generate it like AUTH_SECRET.
CRON_SECRET=""
