// Prisma 7: connection URLs live in prisma.config.ts (CLI) and src/lib/db.ts (runtime adapter).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------- Auth.js (shape from the official @auth/prisma-adapter schema) ----------

model User {
  id            String             @id @default(cuid())
  name          String?
  email         String?            @unique // GitHub users can hide their email
  emailVerified DateTime?
  image         String?
  accounts      Account[]
  sessions      Session[]
  applications  Application[]
  events        ApplicationEvent[]
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  // "Try demo" (PLAN.md §8): a temporary, anonymous user. It never has an Account and is
  // deleted by the cleanup cron one hour after createdAt.
  isDemo        Boolean            @default(false)
  // HMAC of the visitor's IP, only for the demo rate limit; deleted together with the user.
  demoIpHash    String?

  @@index([isDemo, createdAt])
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Unused by GitHub OAuth; kept so email sign-in can be added without a schema change.
model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
}

// ---------- Domain ----------

enum Stage {
  APPLIED
  INTERVIEW
  OFFER
  REJECTED
}

model Application {
  id             String             @id @default(cuid())
  userId         String
  company        String // length limits are enforced by zod
  jobTitle       String
  postingUrl     String?
  notes          String?
  appliedAt      DateTime           @db.Date
  salaryMin      Int? // yearly, whole currency units
  salaryMax      Int?
  salaryCurrency String?            @db.Char(3) // ISO 4217; required by zod when a salary is set
  stage          Stage              @default(APPLIED)
  rank           Int // order within the stage column, ascending
  followUpAt     DateTime?          @db.Date // optional reminder date (calendar date, UTC)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  user           User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  events         ApplicationEvent[]

  @@index([userId, stage, rank])
}

// One row per stage change (PLAN.md §8, V3). Reordering inside a column is not an event.
// userId is denormalized so every read can be scoped by the owner like any other query.
model ApplicationEvent {
  id            String      @id @default(cuid())
  applicationId String
  userId        String
  fromStage     Stage? // null: the application was created in toStage
  toStage       Stage
  at            DateTime    @default(now())
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([applicationId, at])
  @@index([userId, at])
}
